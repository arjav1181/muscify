# muscify — every variable the app reads, and what happens without it.
#
# Nothing here is required. With no configuration at all the player is at `/`,
# anonymous device sync is off, and accounts are inert — which is the default
# and is fully supported.
#
# Copy to `.env.local` for development. Never commit real values: the repo is
# public.

# ---------------------------------------------------------------------------
# Public / private
# ---------------------------------------------------------------------------
# "1" serves the landing page at `/` and puts the player behind an unlisted
# path. Unset (the default) puts the player at `/` and gates nothing.
MUSCIFY_LANDING=

# The unlisted segment the player lives under, e.g. "k7q2m9". Required when
# MUSCIFY_LANDING=1. Purely presentational: the real gate is the session.
MUSCIFY_APP_PATH=

# Emails permitted into a private instance, comma-separated. An empty list
# admits nobody — deliberate, so a misconfigured private instance is locked
# rather than open. Keep real addresses out of this file; set them as a
# deployment secret instead.
MUSCIFY_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Accounts (optional)
# ---------------------------------------------------------------------------
# Required for Auth.js to issue sessions. Generate with:
#   npx auth secret      (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth. Callback URL:
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth. Callback URL:
#   https://<your-domain>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ---------------------------------------------------------------------------
# Storage (optional)
# ---------------------------------------------------------------------------
# Any Postgres 14+ by connection string. Apply db/schema.sql once, by hand:
#   psql "$MUSCIFY_DATABASE_URL" -f db/schema.sql
#
# Deliberately NOT the bare `DATABASE_URL`: that name is set by CI runners and
# Vercel integrations for databases belonging to something else.
#
# On Neon, use the POOLED string (the hostname with `-pooler`) for the app, and
# a direct one when applying the schema.
MUSCIFY_DATABASE_URL=

# "supabase" | "neon" | "postgres" — only needed to opt in to the unprefixed
# generic names. The MUSCIFY_-prefixed ones above are auto-detected.
MUSCIFY_SYNC_BACKEND=

# ---------------------------------------------------------------------------
# Sources (optional)
# ---------------------------------------------------------------------------
# Without a key, search falls back to YouTube's public results page and charts
# degrade. With one, everything works.
YOUTUBE_API_KEY=
