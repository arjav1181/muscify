# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
#
# Without it muscify still runs: Deezer search + charts and the full SomaFM
# radio directory work keyless, and pasted YouTube/Deezer/SoundCloud links
# resolve via oEmbed (which requires no key). Only YouTube *search* and the
# YouTube music chart need this.
#
# The key costs 10,000 units a day and search.list spends 100 of them, so
# muscify caches aggressively and falls back to YouTube's own public search page
# when the budget is gone. Setting it improves result ordering and adds view
# counts; it is not required.
YOUTUBE_API_KEY=


# ---------------------------------------------------------------------------
# Optional library sync
# ---------------------------------------------------------------------------
#
# Off unless configured. With neither set, /api/library answers 501, the client
# stops asking, and everything works exactly as before from local storage. There
# is no account, no email and no personal data: a random device id generated in
# the browser is the only identifier, which is enough to carry your library
# between your own browsers and deliberately not enough to identify you.
#
# Set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, or DATABASE_URL, or neither.
#
# Only the MUSCIFY_-prefixed names below are auto-detected. A bare DATABASE_URL
# is deliberately NOT claimed even when it is set: it is one of the most
# widely-used variable names there is, and Vercel integrations, CI runners and
# local dev boxes all set it for a database that has nothing to do with this
# app. Reading it would mean muscify quietly creating and writing a
# muscify_library table inside someone else's database.
#
# For a Vercel-integrated Neon project, where the variable is set for you and
# renaming is impractical, opt in explicitly:
#
#   MUSCIFY_SYNC_BACKEND=neon        # then DATABASE_URL is honoured
#   MUSCIFY_SYNC_BACKEND=supabase    # then SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are
#
# Create the table once, by hand. This is not applied at runtime: a serverless
# function running DDL on a cold start is a race between concurrent instances,
# and a failed migration should be loud rather than swallowed.
#
#   create table if not exists muscify_library (
#     device_id  text primary key,
#     version    integer not null,
#     snapshot   jsonb   not null,
#     updated_at timestamptz not null default now()
#   );
#   alter table muscify_library enable row level security;
#   grant all on muscify_library to service_role;
#
# Row-level security is on and no policy is granted to anon or authenticated, so
# the table is unreachable from the browser even if the anon key leaks. Only the
# server route touches it, with the service-role key.
#
# Losing localStorage loses the library for good: there is no account to recover
# it from. Sync is a convenience, not a backup.

# --- Supabase ---------------------------------------------------------------
# https://<project-ref>.supabase.co, and the service-role key (not the anon
# key) from Settings → API. Reaching it over PostgREST means this feature adds
# no client library to the bundle.
MUSCIFY_SUPABASE_URL=
MUSCIFY_SUPABASE_SERVICE_ROLE_KEY=

# --- Neon -------------------------------------------------------------------
# The pooled connection string from the Neon console, e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Prefer the -pooler host: the driver pools connections internally and a direct
# endpoint runs out of connections under load.
MUSCIFY_DATABASE_URL=
# ===========================================================================
# Everything below is optional.
#
# With no configuration at all the player is at `/`, anonymous device sync is
# off, and accounts are inert. That is the default and it is fully supported --
# the app is complete without any of this.
# ===========================================================================

# --- Public / private ------------------------------------------------------
# "1" serves the landing page at `/` and puts the player behind an unlisted
# path. Unset puts the player at `/` and gates nothing, which is what anyone
# self-hosting this repo gets.
MUSCIFY_LANDING=

# The unlisted segment the player lives under, e.g. "k7q2m9". Required when
# MUSCIFY_LANDING=1. Presentational only -- the real gate is the session.
MUSCIFY_APP_PATH=

# Emails permitted into a private instance, comma-separated. An empty list
# admits nobody, on purpose: a misconfigured private instance is locked rather
# than silently open. Keep real addresses OUT of this file -- it is committed to
# a public repository. Set them as a deployment secret instead.
MUSCIFY_ALLOWED_EMAILS=

# --- Accounts --------------------------------------------------------------
# Required for Auth.js to issue sessions. Generate with `npx auth secret`
# or `openssl rand -base64 32`.
AUTH_SECRET=

# Google / GitHub OAuth. Callback URLs:
#   https://<your-domain>/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# --- Storage ---------------------------------------------------------------
# Any Postgres 14+ by connection string. Apply the schema once, by hand:
#   psql "$MUSCIFY_DATABASE_URL" -f db/schema.sql
#
# Deliberately NOT the bare `DATABASE_URL`: CI runners and Vercel integrations
# set that name for databases belonging to something else, and it has already
# pointed this project at an unrelated database once.
#
# On Neon use the POOLED string (hostname ending `-pooler`) for the app, and a
# direct one when applying the schema.
MUSCIFY_DATABASE_URL=

# "supabase" | "neon" | "postgres". Only needed to opt in to the unprefixed
# generic names; the MUSCIFY_-prefixed variables above are auto-detected.
MUSCIFY_SYNC_BACKEND=
